#!/usr/bin/env bash
set -euo pipefail

# Trigger a Coolify deploy for this app.
# Reads COOLIFY_API_TOKEN and COOLIFY_APP_UUID from .env, polls until done.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$SCRIPT_DIR/../.env"

if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
else
  echo "ERROR: .env file not found at $ENV_FILE" >&2
  exit 1
fi

: "${COOLIFY_API_TOKEN:?COOLIFY_API_TOKEN not set in .env}"
: "${COOLIFY_APP_UUID:?COOLIFY_APP_UUID not set in .env}"

: "${COOLIFY_HOST:?COOLIFY_HOST not set in .env}"
COOLIFY_PORT="${COOLIFY_PORT:-8000}"

echo "Deploying app ${COOLIFY_APP_UUID}..."

response=$(curl -sf -X GET \
  "http://${COOLIFY_HOST}:${COOLIFY_PORT}/api/v1/deploy?uuid=${COOLIFY_APP_UUID}" \
  -H "Authorization: Bearer ${COOLIFY_API_TOKEN}")

deployment_uuid=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin)['deployments'][0]['deployment_uuid'])")
message=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin)['deployments'][0]['message'])")

echo "$message"
echo "Deployment ID: $deployment_uuid"
echo ""

echo -n "Waiting for deployment"
while true; do
  status=$(curl -sf \
    "http://${COOLIFY_HOST}:${COOLIFY_PORT}/api/v1/deployments/${deployment_uuid}" \
    -H "Authorization: Bearer ${COOLIFY_API_TOKEN}" \
    | python3 -c "import sys,json; print(json.load(sys.stdin).get('status','unknown'))")

  if [ "$status" = "finished" ]; then
    echo ""
    echo "Deployed successfully."
    break
  elif [ "$status" = "failed" ] || [ "$status" = "error" ]; then
    echo ""
    echo "ERROR: Deployment $status." >&2
    exit 1
  else
    echo -n "."
    sleep 5
  fi
done
